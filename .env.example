# Browser-safe values. These are embedded in the static GitHub Pages bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Supabase Edge Function secrets. Never put these in VITE_ variables.
APP_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
APP_SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
APP_CRON_SECRET=RANDOM_LONG_CRON_SECRET
APP_ALLOWED_ORIGIN=https://throne-of-ease.github.io

# Used only by `supabase db push` to populate the cron Vault entries.
SUPABASE_PROJECT_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
